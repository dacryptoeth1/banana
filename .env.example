# demo (default) = localStorage only, Demo menu + Reset demo. live = real sign-in.
# Inlined at build time: change it, then rebuild/redeploy.
NEXT_PUBLIC_BANANA_MODE=demo

# --- everything below is only needed when NEXT_PUBLIC_BANANA_MODE=live ---

# Signs the session and the email-code challenge.  openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=

# Resend, for the 6-digit code email. EMAIL_FROM must be on a domain verified in Resend, e.g. "Banana <login@banana.africa>".
# In `next dev` with these unset, the code is printed to the server console instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=

# Paystack TEST secret key (dashboard → Settings → API Keys & Webhooks, Test mode). Must start with sk_test_ ; live keys are refused.
# Live mode only. Server-side; never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=

# Paystack TEST public key (pk_test_…). Not used by the redirect checkout yet; reserved for Paystack inline.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
